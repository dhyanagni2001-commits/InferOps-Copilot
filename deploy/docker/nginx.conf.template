# Rendered by the nginx entrypoint; only defined environment variables (BACKEND_URL) are substituted.
server {
    listen 8080;
    root /usr/share/nginx/html;
    server_tokens off;


    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Server-Sent Events: HTTP/1.1, no buffering, long reads.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
        client_max_body_size 16k;
    }

    location = /health/live { proxy_pass ${BACKEND_URL}; }
    location = /health/ready { proxy_pass ${BACKEND_URL}; }

    # add_header in a location replaces inherited headers, so security headers are set per location.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:" always;
    }
}
