# Copy to .env (never commit it). Values shown are the development defaults.
APP_ENV=development                     # "production" refuses the default token
API_BEARER_TOKEN=dev-token              # entered in the UI at runtime; use a long random value outside dev
K8S_ALLOWED_NAMESPACES=inferops-demo    # comma-separated allowlist
DEMO_MODE=true                          # true: replay recorded scenarios; false: read the cluster with kubectl
KUBECTL_PATH=kubectl
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
AGENT_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_CALLS=8
MAX_LOG_LINES=60
MAX_CONCURRENT_REQUESTS=4
RATE_LIMIT_PER_MINUTE=20

# Retrieval
EMBEDDING_BACKEND=hash                  # hash (offline) | triton
TRITON_HTTP_URL=http://127.0.0.1:8002
TRITON_MODEL_NAME=embedding
EMBEDDING_TOKENIZER_PATH=model_repository/embedding/tokenizer/tokenizer.json
USE_QDRANT=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=inferops_docs
DOCS_INDEX_PATH=data/docs-index.json

# Generation (optional)
USE_LLM=false
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_TIMEOUT_SECONDS=30
